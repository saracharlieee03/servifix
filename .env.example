# Copie este archivo como ".env" y ponga sus datos reales.
# El archivo .env NO se sube a GitHub (está en .gitignore).

# MongoDB Atlas -> Database -> Connect -> Drivers
MONGO_URI=mongodb+srv://USUARIO:CONTRASEÑA@CLUSTER.mongodb.net/?retryWrites=true&w=majority
DB_NAME=servifix_db

# Cloudinary -> Dashboard
CLOUDINARY_CLOUD_NAME=su_cloud_name
CLOUDINARY_API_KEY=su_api_key
CLOUDINARY_API_SECRET=su_api_secret

# Google Gemini (IA) -> https://aistudio.google.com/apikey  (gratis con una cuenta de Google)
GEMINI_API_KEY=su_clave_de_gemini
# Opcional: modelo a usar (si no se pone, se usa gemini-3.5-flash-lite)
# GEMINI_MODEL=gemini-3.5-flash-lite

# Solo para la interfaz: dirección del backend (en local no hace falta)
# API_URL=https://servifix-api.onrender.com
